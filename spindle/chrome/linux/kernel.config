# Spindle's changes to Alpine's configuration for its virt kernel (aports
# main/linux-lts/virt.x86.config, pinned in build.sh), merged over it by build.sh.
#
# v86 boots this kernel with no boot image, and the image has never carried modules
# (/lib/modules was always left out), so the kernel has none: what the boot image used to
# load is built in (the 9p root and its virtio transport, the network card, loop), and
# build.sh leaves out everything else Alpine builds as a module, as the image did. With no
# modules there is nothing to sign, so no signing key is made at build time.
CONFIG_NETFS_SUPPORT=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_VIRTIO_NET=y
CONFIG_BLK_DEV_LOOP=y

# Smaller: the kernel is compressed with xz (Alpine's with gzip).
CONFIG_KERNEL_XZ=y

# The same sources give the same kernel: no compile-time randomness (GCC plugins), no
# debug information (the compressed kernel never carries it; it only slows the build).
# CONFIG_GCC_PLUGINS is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF5 is not set
CONFIG_LOCALVERSION="-spindle"
# CONFIG_LOCALVERSION_AUTO is not set

# Left out, as a browser's emulated PC never has or needs them (a smaller kernel, and a
# faster one: on an emulated CPU, which does not speculate, the CPU mitigations only cost
# time): other hypervisors' guest support, disks (the root is 9p), RAID and USB, audit and
# AppArmor (no policies), tracing and debugging aids, suspend and hibernation, encrypted
# and verity files, multipath TCP, the firewall, BPF programs, traffic shaping, multicast
# and policy routing, the kernel's own DHCP (sysinit sets the address), a mouse and other
# input, crypto hardware; and all but one CPU (v86 emulates one). Commands use namespaces
# only (command/src/sandbox.rs, guest/agent.py).
# CONFIG_HYPERVISOR_GUEST is not set
# CONFIG_ATA is not set
# CONFIG_SCSI is not set
# CONFIG_MD is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_AUDIT is not set
# CONFIG_SECURITY_APPARMOR is not set
# CONFIG_FTRACE is not set
# CONFIG_PROFILING is not set
# CONFIG_DYNAMIC_DEBUG is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_DEBUG_LIST is not set
# CONFIG_CPU_MITIGATIONS is not set
# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set
# CONFIG_FS_ENCRYPTION is not set
# CONFIG_FS_VERITY is not set
# CONFIG_MPTCP is not set
# CONFIG_NETFILTER is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_NET_SCHED is not set
# CONFIG_IP_ADVANCED_ROUTER is not set
# CONFIG_IP_MROUTE is not set
# CONFIG_IP_PNP is not set
# CONFIG_IPV6_MROUTE is not set
# CONFIG_IPV6_MULTIPLE_TABLES is not set
# CONFIG_IPV6_SUBTREES is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_INPUT_MISC is not set
# CONFIG_CRYPTO_HW is not set
# CONFIG_SMP is not set
