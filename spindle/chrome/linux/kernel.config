# Spindle's changes to Alpine's configuration for its virt kernel (aports
# main/linux-lts/virt.x86.config, pinned in build.sh), merged over it by build.sh.
#
# v86 boots this kernel with no boot image, and the image has never carried modules
# (/lib/modules was always left out), so the kernel has none: what the boot image used to
# load is built in (the 9p root and its virtio transport, the network card, loop), and
# build.sh leaves out everything else Alpine builds as a module, as the image did. With no
# modules there is nothing to sign, so no signing key is made at build time.
CONFIG_NETFS_SUPPORT=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_VIRTIO_NET=y
CONFIG_BLK_DEV_LOOP=y

# Smaller: the kernel is compressed with xz (Alpine's with gzip).
CONFIG_KERNEL_XZ=y

# The same sources give the same kernel: no compile-time randomness (GCC plugins), no
# debug information (the compressed kernel never carries it; it only slows the build).
# CONFIG_GCC_PLUGINS is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF5 is not set
CONFIG_LOCALVERSION="-spindle"
# CONFIG_LOCALVERSION_AUTO is not set
