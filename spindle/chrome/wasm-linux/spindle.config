# Spindle's additions to arch/wasm's defconfig (build-kernel.sh merges them).
# Shares over virtio-9p: the root and each command's workspace.
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
# (Fresh /tmp and the like for each command need no option: without an MMU the kernel's
# tmpfs is ramfs, always there.)
# What programs expect of a Linux (Python's multiprocessing, for one).
CONFIG_SYSVIPC=y
# Each command in namespaces of its own, as the v86 runner gives them.
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
# A CPU running a task that never calls the kernel cannot be preempted or interrupted
# here: with full dynticks (and the context tracking kernel/context-tracking.patch
# lets the arch offer) RCU counts it as quiescent instead of every grace period waiting
# on it; CPU 0 keeps the housekeeping (nohz_full=1-N, runner.mjs).
CONFIG_NO_HZ_FULL=y
