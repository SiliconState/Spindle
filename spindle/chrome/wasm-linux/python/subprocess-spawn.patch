+#ifdef SPAWN_EXEC
+/* The highest descriptor open here, or -1 (when /proc cannot say). */
+static int
+highest_open_fd(void)
+{
+    DIR *dir = opendir("/proc/self/fd");
+    if (dir == NULL) {
+        return -1;
+    }
+    int highest = -1;
+    struct dirent *entry;
+    while ((entry = readdir(dir)) != NULL) {
+        int fd = _pos_int_from_ascii(entry->d_name);
+        if (fd > highest && fd != dirfd(dir)) {
+            highest = fd;
+        }
+    }
+    closedir(dir);
+    return highest;
+}
+
+/* fork_exec where there is no fork: the child is started with posix_spawn, doing what
+ * child_exec() would before its exec as far as posix_spawn can: the standard
+ * descriptors (one that is itself 0, 1 or 2 moved out of the way first), descriptors 3
+ * and up closed but those kept (which the child inherits), the directory, SIGPIPE and
+ * SIGXFSZ restored, a new session or process group, the umask (set here around the
+ * spawn, with the GIL held so no other Python thread creates a file meanwhile).
+ * preexec_fn and user or group changes cannot be done and are refused. An exec that
+ * fails (for every name in exec_array) is raised here as the child's report would be
+ * raised by subprocess, naming the program (the one path, when there is one; else
+ * argv[0]). Without /proc (never so in Spindle's sandbox) the descriptors closed are
+ * 3 to 255 only. Returns the child's pid, or -1 with an exception set. */
+static pid_t
+spawn_exec(char *const exec_array[], char *const argv[], char *const envp[],
+           const char *cwd, int p2cread, int c2pwrite, int errwrite,
+           int close_fds, int restore_signals, int call_setsid, pid_t pgid_to_set,
+           gid_t gid, Py_ssize_t extra_group_size, uid_t uid, int child_umask,
+           int *fds_to_keep, Py_ssize_t fds_to_keep_len, int errpipe_write,
+           PyObject *preexec_fn)
+{
+    if (preexec_fn != Py_None) {
+        PyErr_SetString(PyExc_RuntimeError,
+                        "preexec_fn is not supported on this platform (no fork)");
+        return -1;
+    }
+    if (gid != (gid_t)-1 || uid != (uid_t)-1 || extra_group_size >= 0) {
+        PyErr_SetString(PyExc_OSError,
+                        "changing the child's user or groups is not supported on "
+                        "this platform (no fork)");
+        return -1;
+    }
+    /* The directory is checked here: the child's chdir failing would be told as the
+     * program's failure. */
+    if (cwd != NULL) {
+        struct stat info;
+        if (stat(cwd, &info) != 0 || access(cwd, X_OK) != 0) {
+            PyErr_SetFromErrnoWithFilename(PyExc_OSError, cwd);
+            return -1;
+        }
+        if (!S_ISDIR(info.st_mode)) {
+            errno = ENOTDIR;
+            PyErr_SetFromErrnoWithFilename(PyExc_OSError, cwd);
+            return -1;
+        }
+    }
+
+    posix_spawn_file_actions_t actions;
+    posix_spawnattr_t attrs;
+    posix_spawn_file_actions_init(&actions);
+    posix_spawnattr_init(&attrs);
+    int highest = highest_open_fd();
+    if (highest < 2) {
+        highest = 255;
+    }
+    int sources[3] = {p2cread, c2pwrite, errwrite};
+    int moved[3] = {-1, -1, -1};
+    /* A source that is itself one of 0, 1, 2 (and not its own target) could be
+     * overwritten by an earlier dup2: it goes above every open descriptor first. */
+    for (int target = 0; target < 3; target++) {
+        if (sources[target] >= 0 && sources[target] <= 2 && sources[target] != target) {
+            moved[target] = highest + 1 + target;
+            posix_spawn_file_actions_adddup2(&actions, sources[target], moved[target]);
+            sources[target] = moved[target];
+        }
+    }
+    /* dup2 onto itself clears close-on-exec, as child_exec() makes it inheritable. */
+    for (int target = 0; target < 3; target++) {
+        if (sources[target] >= 0) {
+            posix_spawn_file_actions_adddup2(&actions, sources[target], target);
+        }
+    }
+    for (int target = 0; target < 3; target++) {
+        if (moved[target] >= 0) {
+            posix_spawn_file_actions_addclose(&actions, moved[target]);
+        }
+    }
+    /* What is kept the child inherits (the error pipe aside: it is ours alone here). */
+    for (Py_ssize_t i = 0; i < fds_to_keep_len; i++) {
+        if (fds_to_keep[i] != errpipe_write) {
+            posix_spawn_file_actions_adddup2(&actions, fds_to_keep[i], fds_to_keep[i]);
+        }
+    }
+    if (close_fds) {
+        for (int fd = 3; fd <= highest; fd++) {
+            if (!_is_fd_in_sorted_fd_sequence(fd, fds_to_keep, fds_to_keep_len)) {
+                posix_spawn_file_actions_addclose(&actions, fd);
+            }
+        }
+    }
+    if (cwd != NULL) {
+        posix_spawn_file_actions_addchdir_np(&actions, cwd);
+    }
+    short flags = 0;
+    if (restore_signals) {
+        sigset_t defaults;
+        sigemptyset(&defaults);
+#ifdef SIGPIPE
+        sigaddset(&defaults, SIGPIPE);
+#endif
+#ifdef SIGXFSZ
+        sigaddset(&defaults, SIGXFSZ);
+#endif
+        posix_spawnattr_setsigdefault(&attrs, &defaults);
+        flags |= POSIX_SPAWN_SETSIGDEF;
+    }
+    if (call_setsid) {
+        flags |= POSIX_SPAWN_SETSID;
+    }
+    if (pgid_to_set >= 0) {
+        posix_spawnattr_setpgroup(&attrs, pgid_to_set);
+        flags |= POSIX_SPAWN_SETPGROUP;
+    }
+    posix_spawnattr_setflags(&attrs, flags);
+
+    pid_t pid = -1;
+    int err = ENOENT;
+    /* The umask is the process's: changed only with the GIL held. */
+    PyThreadState *released = child_umask >= 0 ? NULL : PyEval_SaveThread();
+    mode_t old_umask = 0;
+    if (child_umask >= 0) {
+        old_umask = umask(child_umask);
+    }
+    /* As child_exec() tries each name: the first error that is not a missing file wins. */
+    int first = 0;
+    for (int i = 0; exec_array[i] != NULL; i++) {
+        int result = posix_spawn(&pid, exec_array[i], &actions, &attrs, argv,
+                                 envp ? envp : environ);
+        if (result == 0) {
+            err = 0;
+            break;
+        }
+        if (result != ENOENT && result != ENOTDIR && first == 0) {
+            first = result;
+        }
+        err = first ? first : result;
+    }
+    if (child_umask >= 0) {
+        umask(old_umask);
+    }
+    if (released != NULL) {
+        PyEval_RestoreThread(released);
+    }
+    posix_spawn_file_actions_destroy(&actions);
+    posix_spawnattr_destroy(&attrs);
+    if (err != 0) {
+        errno = err;
+        const char *named = exec_array[0] != NULL && exec_array[1] == NULL ? exec_array[0] : argv[0];
+        PyErr_SetFromErrnoWithFilename(PyExc_OSError, named);
+        return -1;
+    }
+    return pid;
+}
+#endif /* SPAWN_EXEC */
 
